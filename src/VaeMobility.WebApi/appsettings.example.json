{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "VaeMobility",
    "Audience": "VaeMobility.WebApi",
    "SigningKey": "",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Auth": {
    "Cookies": {
      "AccessTokenName": "vaemobility_access_token",
      "RefreshTokenName": "vaemobility_refresh_token",
      "SameSite": "Lax",
      "Secure": false,
      "Path": "/"
    }
  },
  "Cloudflare": {
    "R2": {
      "AccountId": "",
      "AccessKey": "",
      "SecretKey": "",
      "Bucket": "",
      "ServiceUrl": "",
      "PublicBaseUrl": ""
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "http://localhost:9000",
      "http://127.0.0.1:9000"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
